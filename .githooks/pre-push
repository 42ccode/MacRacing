#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
set --
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) ;;
        *) set -- "$@" "$local_oid" ;;
    esac
done
[ "$#" -gt 0 ] || exit 0
exec python3 Tools/check_publication.py "$@"
